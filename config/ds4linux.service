[Unit]
Description=DS4Linux — Sony Controller Bridge Daemon
Documentation=https://github.com/PalashDalsaniya/ds4linux
After=systemd-udevd.service modprobe@uhid.service modprobe@uinput.service
Wants=modprobe@uhid.service modprobe@uinput.service

[Service]
Type=simple
# Extra daemon options (e.g. DS4LINUX_ARGS=--generic) go in /etc/default/ds4linux
EnvironmentFile=-/etc/default/ds4linux
ExecStart=/usr/bin/ds4linux-daemon $DS4LINUX_ARGS
Restart=on-failure
RestartSec=3
# Let udev finish re-processing controllers a previous instance released,
# so those events can't undo the hiding this one is about to apply
ExecStartPre=-/usr/bin/udevadm settle --timeout=5
# Give the physical controllers back even if the daemon crashed: drop its
# hiding rules and re-apply the normal permissions and uaccess ACLs ("+"
# runs these outside the sandbox below)
ExecStopPost=+-/usr/bin/rm -f /run/udev/rules.d/72-ds4linux-hidden.rules
ExecStopPost=+-/usr/bin/udevadm control --reload
ExecStopPost=+-/usr/bin/udevadm trigger --settle --action=change --subsystem-match=hidraw --subsystem-match=input

# Security hardening
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=no
ReadWritePaths=/run

# Profiles and per-controller profile assignments (/var/lib/ds4linux)
StateDirectory=ds4linux

# The daemon needs the evdev and hidraw nodes, /dev/uhid (virtual DS4) and
# /dev/uinput (virtual Xbox 360).  Device globs are not supported here, so
# allow the whole input and hidraw device classes.
DeviceAllow=char-input  rw
DeviceAllow=char-hidraw rw
DeviceAllow=/dev/uhid   rw
DeviceAllow=/dev/uinput rw

# Run as root (needed for EVIOCGRAB, uhid and uinput)
User=root
Group=root

# Socket path
RuntimeDirectory=ds4linux

# Not enabled by the packages: start it when you want emulation
# (ds4linux-ctl start, or the GUI), or `ds4linux-ctl autostart on` to
# start it at boot.
[Install]
WantedBy=multi-user.target
