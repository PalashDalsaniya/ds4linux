# ds4linux udev rules
#
# The physical controllers are NOT hidden here: the daemon hides a
# controller's nodes itself (mode 0600, no ACL) only while it is using it,
# and gives them back (a "change" uevent re-applies these rules and the
# uaccess ACL) when it stops.  With the daemon stopped, the raw controller
# works normally.

# REVEAL the virtual DualShock 4 (UHID device, PID 05C4) to the logged-in
# user, so Steam and games can read its hidraw node (gyro, touchpad,
# rumble).  Only devices under the uhid misc device with the USB bus type
# match, so a real USB DS4 v1, or a Bluetooth controller handled by
# bluetoothd (also under uhid, bus 0005), keeps its normal permissions.
# Input classification (joystick vs. touchpad vs. motion sensor) is left to
# the stock input_id rules.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/0003:054C:05C4.*", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", DEVPATH=="/devices/virtual/misc/uhid/0003:054C:05C4.*", MODE="0666", TAG+="uaccess"
