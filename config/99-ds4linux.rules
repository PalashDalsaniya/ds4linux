# ds4linux udev rules
#
# 1. HIDE the physical DualSense / DualSense Edge from non-root users (Steam, etc.)
#    The daemon runs as root and has already opened these fds before udev runs.
#    USB devices are matched by idVendor/idProduct; Bluetooth devices (which
#    have no USB attributes) by their HID device name (bus 0005).
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0600", TAG-="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0600", TAG-="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0600", TAG-="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0600", TAG-="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:054C:0CE6.*", MODE="0600", TAG-="uaccess"
SUBSYSTEM=="input", KERNELS=="0005:054C:0CE6.*", MODE="0600", TAG-="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:054C:0DF2.*", MODE="0600", TAG-="uaccess"
SUBSYSTEM=="input", KERNELS=="0005:054C:0DF2.*", MODE="0600", TAG-="uaccess"

# 2. REVEAL the Virtual DualShock 4 v1 (UHID device, PID 05C4).
#    Only devices under the uhid misc device match, so a real USB DS4 v1
#    keeps its normal permissions.  Input classification (joystick vs.
#    touchpad vs. motion sensor) is left to the stock input_id rules.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/0003:054C:05C4.*", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", DEVPATH=="/devices/virtual/misc/uhid/0003:054C:05C4.*", MODE="0666", TAG+="uaccess"
